# ==========================================
# QODEKRAFT ENVIRONMENT EXAMPLE
# ==========================================

APP_NAME=QodeKraft API
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

# ==========================================
# MYSQL
# ==========================================

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=qodekraft
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

DATABASE_URL=mysql+pymysql://root:your_mysql_password@mysql:3306/qodekraft?charset=utf8mb4

# ==========================================
# SECURITY
# ==========================================

SECRET_KEY=your_long_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# FRONTEND / ADMIN
# ==========================================

FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ==========================================
# FILE UPLOAD
# ==========================================

UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=25

# ==========================================
# EMAIL
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# ==========================================
# ADMIN
# ==========================================

ADMIN_EMAIL=
ADMIN_PASSWORD=

# ==========================================
# RAZORPAY
# ==========================================

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=